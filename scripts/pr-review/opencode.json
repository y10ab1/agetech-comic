{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/global.openai.gpt-6-astra",
  "small_model": "amazon-bedrock/global.openai.gpt-6-astra",
  "share": "disabled",
  "snapshot": false,
  "autoupdate": false,
  "formatter": false,
  "lsp": false,
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": "deny",
    "todowrite": "allow"
  },
  "agent": {
    "pr-reviewer": {
      "description": "Read-only PR review; the controller runs checks and publishes the result.",
      "mode": "primary"
    }
  }
}
